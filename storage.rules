rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
// Simplified approach without Firestore lookup
    // Teachers can upload/read their own signatures
    // Admins will need Firestore client-side checks
    match /signatures/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
