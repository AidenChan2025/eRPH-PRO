{
  "name": "erph-pro",
  "version": "0.0.46",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bump-version": "node scripts/bump_version.js",
    "build": "npm run bump-version && vite build",
    "build:max": "npm run bump-version && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --minify false",
    "build:clean": "rm -rf node_modules/.vite build && npm run build:max",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "*",
    "firebase": "^11.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}