{
  "name": "erph-pro",
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bump-version": "node scripts/bump_version.js",
    "build": "npm run bump-version && vite build",
    "build:max": "npm run bump-version && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --minify false",
    "build:clean": "rm -rf node_modules/.vite build && npm run build:max",
    "preview": "vite preview",
    "i18n-audit": "node scripts/i18n-audit.js",
    "predeploy": "npm run build && npm run i18n-audit",
    "deploy": "npx firebase deploy --only hosting",
    "serve:firebase": "npx firebase emulators:start --only hosting"
  },
  "dependencies": {
    "@google/genai": "*",
    "@react-pdf/renderer": "^4.3.2",
    "date-fns": "^4.1.0",
    "firebase": "^11.0.2",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^6.28.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "firebase-tools": "^15.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
